{
  "global": {
    "timeoutSeconds": 30,
    "parallelExecution": true,
    "maxThreads": 5,
    "reportPath": "./Reports",
    "userAgent": "PCUpdateChecker/1.0",
    "logging": {
      "path": "./Logs",
      "level": "Info"
    }
  },
  "components": [
    {
      "id": "nvidia-driver",
      "name": "NVIDIA Graphics Driver",
      "category": "Driver",
      "priority": "High",
      "detection": {
        "method": "WMI",
        "query": "SELECT DriverVersion FROM Win32_VideoController WHERE Name LIKE '%NVIDIA%'",
        "property": "DriverVersion",
        "transformRegex": "^(\\d+\\.\\d+)" 
      },
      "fetching": {
        "method": "Scrape",
        "url": "https://www.nvidia.com/Download/processDriver.aspx?psid=101&pfid=816&rpf=1",
        "regex": "Version: ([0-9.]+)"
      }
    },
    {
      "id": "vscode",
      "name": "Visual Studio Code",
      "category": "Software",
      "priority": "Medium",
      "autoUpdate": true,
      "detection": {
        "method": "File",
        "path": "C:\\Program Files\\Microsoft VS Code\\Code.exe",
        "property": "ProductVersion"
      },
      "fetching": {
        "method": "Winget",
        "packageId": "Microsoft.VisualStudioCode"
      }
    },
    {
      "id": "powertoys",
      "name": "PowerToys",
      "category": "Software",
      "priority": "Low",
      "autoUpdate": true,
      "detection": {
        "method": "Winget",
        "packageId": "Microsoft.PowerToys"
      },
      "fetching": {
        "method": "Winget",
        "packageId": "Microsoft.PowerToys"
      }
    },
    {
      "id": "armoury-crate",
      "name": "ASUS Armoury Crate",
      "category": "Software",
      "priority": "Medium",
      "autoUpdate": false,
      "_note": "autoUpdate intentionally disabled - Armoury Crate replaced by G-Helper, do not reinstall",
      "detection": {
        "method": "File",
        "path": "C:\\Program Files\\ASUS\\ARMOURY CRATE Service\\ArmouryCrate.Service.exe",
        "property": "ProductVersion"
      },
      "fetching": {
        "strategies": [
          {
            "method": "Winget",
            "packageId": "ASUS.ArmouryCrateLite"
          },
          {
            "method": "Scrape",
            "url": "https://rog.asus.com/us/innovation/armoury-crate/",
            "regex": "Version ([0-9.]+)"
          }
        ]
      }
    },
    {
      "id": "g-helper",
      "name": "G-Helper",
      "category": "Software",
      "priority": "High",
      "autoUpdate": false,
      "_note": "autoUpdate false - GitHub-sourced updates report only, do not auto-execute a downloaded installer",
      "detection": {
        "method": "File",
        "path": "C:\\Users\\joe6p\\Downloads\\GHelper.exe",
        "property": "ProductVersion"
      },
      "fetching": {
        "method": "GitHub",
        "repo": "seerge/g-helper",
        "assetRegex": "GHelper.*\\.exe$"
      }
    },
    {
      "id": "geforce-experience",
      "name": "NVIDIA GeForce Experience",
      "category": "Software",
      "priority": "Medium",
      "autoUpdate": true,
      "detection": {
        "method": "File",
        "path": "C:\\Program Files\\NVIDIA Corporation\\NVIDIA GeForce Experience\\NVIDIA GeForce Experience.exe",
        "property": "ProductVersion"
      },
      "fetching": {
        "strategies": [
          {
            "method": "Winget",
            "packageId": "Nvidia.GeForceExperience"
          },
          {
            "method": "Scrape",
            "url": "https://www.nvidia.com/en-us/geforce/geforce-experience/",
            "regex": "version\"\\s*:\\s*\"([0-9.]+)\""
          }
        ]
      }
    },
    {
      "id": "razer-synapse",
      "name": "Razer Synapse 3",
      "category": "Software",
      "priority": "Medium",
      "autoUpdate": true,
      "detection": {
        "method": "Registry",
